# MongoDB Atlas: Database > Connect > Drivers, then put the database name
# (temple_counter) before the "?".
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/temple_counter?retryWrites=true&w=majority
JWT_SECRET=change-me
PORT=4000
TEMPLE_TZ=Asia/Kolkata
DEVICE_TOKEN_PEPPER=change-me
# Where the admin web app is served from (comma-separated for several).
WEB_ORIGIN=http://localhost:5173
